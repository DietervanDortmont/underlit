<Window x:Class="Underlit.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Underlit.UI"
        Title="Underlit Settings"
        Width="760" Height="600"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <!--
            v0.6.40: visual system overhaul. Apple/iOS-flavoured palette,
            consistent typography rhythm (page title 22 / caption 11 SC /
            row label 13 / value chip 12 SC), pill-shaped scrollbar, iOS-
            style toggle switch, refined slider, themed tooltip.
            All theme-reactive brushes are DynamicResource — populated by
            ApplyTheme() at runtime to follow Windows dark/light only
            (no longer dependent on OSD backdrop choice).
        -->

        <!-- ===== Sidebar ===== -->
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Card / row scaffolding ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="Margin" Value="6,18,0,8"/>
            <!-- iOS-style "section header": small caps with a touch of letter spacing. -->
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource App.Divider}"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="16,0,12,0"/>
        </Style>

        <!-- Inline hint TextBlocks are deprecated in v0.6.40; kept as a
             style so XAML that still uses it doesn't break, but we set
             Visibility=Collapsed by default so leftover hints just don't
             render. The same explanatory text shows up as a tooltip on
             the adjacent control instead, on hover. -->
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ===== Themed tooltip (Apple-style minimal popup) ===== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource App.CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                MaxWidth="320">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="14"
                                                  ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <!-- v0.6.41: TextBlock.TextWrapping is NOT an
                                 attached property in WPF, so it can't be
                                 set on ContentPresenter (CI build flagged
                                 MC3015). Bind a TextBlock directly to the
                                 tooltip's Content instead. All call sites
                                 pass plain strings, which is the common
                                 tooltip case. -->
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== iOS-style toggle switch =====
             Two layered backgrounds: the off-state track (theme grey, always
             present underneath) plus a green ON overlay whose Opacity
             animates 0..1 on IsChecked. This avoids the v0.6.40 problem
             where the ColorAnimation only had EnterActions, so flipping
             OFF left the track stuck on green. The opacity approach also
             means the brushes don't get globally mutated, which is what
             happens when you ColorAnimate on a DynamicResource brush.
        -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="44" Height="26"
                                CornerRadius="13"
                                Background="{DynamicResource App.ToggleTrackOff}"
                                BorderThickness="0">
                            <Grid>
                                <!-- Green overlay for the ON state. Opacity
                                     animates 0..1 to fade in/out. -->
                                <Border x:Name="OnOverlay"
                                        CornerRadius="13"
                                        Background="#FF34C759"
                                        Opacity="0"/>
                                <Ellipse x:Name="Knob"
                                         Width="22" Height="22"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="White"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" X="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="4"
                                                          ShadowDepth="1" Opacity="0.30"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="OnOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="OnOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default every CheckBox to the toggle switch look unless a
             site explicitly opts out. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}"/>

        <!-- ===== Apple-style slider ===== -->
        <Style x:Key="AppleSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6"
                                                      ShadowDepth="1" Opacity="0.28"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Halo" Fill="{DynamicResource App.Accent}"
                                     Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
            <Setter Property="Background" Value="{DynamicResource App.TrackBg}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                            <Track x:Name="PART_Track" Height="22" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- The "decrease" side of the track is the
                                                     filled portion (left of thumb); paint it
                                                     with the slider's accent foreground. -->
                                                <Border Height="4" CornerRadius="2"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Foreground,
                                                                     RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppleSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Themed text input ===== -->
        <Style x:Key="AppleTextBox" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{DynamicResource App.InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Refined dropdown (ComboBox) ===== -->
        <Style x:Key="AppleComboBox" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Padding" Value="12,7,10,7"/>
            <Setter Property="Background" Value="{DynamicResource App.InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <Binding Path="Background" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <Binding Path="BorderBrush" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.BorderThickness>
                                    <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </ToggleButton.BorderThickness>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Width="9" Height="6"
                                  Stretch="Fill"
                                  Fill="{DynamicResource App.TextSecondary}"
                                  Data="M 0 0 L 4.5 6 L 9 0 Z"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Margin="0,4,0,8"
                                        CornerRadius="10"
                                        Background="{DynamicResource App.CardBg}"
                                        BorderBrush="{DynamicResource App.CardBorder}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="20"
                                                          ShadowDepth="3" Opacity="0.22"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default ComboBox to the Apple style without forcing every site
             to opt in via Style attribute. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource AppleComboBox}"/>

        <!-- ===== Pill scrollbar ===== -->
        <Style x:Key="PillScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3"
                                Background="{DynamicResource App.TextSecondary}"
                                Opacity="0.42"
                                Margin="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Width="6"
                                   HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PillScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValueChip" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <!-- Wide enough that "+200 K" / "1500 K" fit without clipping. -->
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,0,16,0"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Default Slider style — every Slider in the app picks up the
             AppleSlider template (thin track, glass thumb, accent fill on
             the left). The previous v0.6.40 keyed AppleSlider with no
             default meant that liquid-glass tuning sliders (which weren't
             explicitly opted in) kept the chunky default WPF look. -->
        <Style TargetType="Slider" BasedOn="{StaticResource AppleSlider}"/>

        <!-- ===== Icon button (transparent, scale-bounce on hover) =====
             Used for the profile rename / clone / delete row. No visible
             box; hover scales the icon up about 12% with a quick bouncy
             cubic-out so it feels lively without grabbing attention. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.16" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.16" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Pill action button =====
             v0.6.45: shorter (5 px vertical padding), high-contrast
             background (App.ButtonBg = dark in light mode, light in dark
             mode), no border, hover = scale-up bounce only (no colour
             shift / no border highlight). Reads as a real button against
             the surrounding card without the chunky WPF default chrome. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource App.ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.ButtonFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- v0.6.49: clamp button height. WPF's default button measure
                 takes whatever the parent grid row gives it (the Row style
                 has MinHeight=48), which made our supposedly-short pills
                 still render ~38 dip tall. Explicit Height=24 + tighter
                 padding gets a true compact pill that doesn't grow. -->
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource App.WindowBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource App.SidebarBg}" Padding="0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,4,16,16" Orientation="Horizontal">
                    <Image x:Name="AppLogo" Width="28" Height="28" Margin="0,0,10,0"/>
                    <TextBlock Text="Underlit"
                               FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextPrimary}"/>
                </StackPanel>
                <!-- v0.6.48: pinned About footer. Always visible at the
                     bottom of the sidebar so the user can see the version
                     and reach GitHub / logs without hunting through pages. -->
                <Border DockPanel.Dock="Bottom"
                        Padding="16,12"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LblAppVersion"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondary}"
                                   Margin="0,0,0,4"
                                   Text="Underlit"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAboutGithub"
                                    Style="{StaticResource IconButton}"
                                    Padding="2"
                                    ToolTip="Open the project on GitHub">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource App.TextSecondary}"
                                           Text="&#xE71B;"/>
                            </Button>
                            <Button Grid.Column="2"
                                    x:Name="BtnAboutLog"
                                    Style="{StaticResource IconButton}"
                                    Padding="2"
                                    ToolTip="Open the log folder for bug reports">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource App.TextSecondary}"
                                           Text="&#xE8A5;"/>
                            </Button>
                        </Grid>
                        <Button x:Name="BtnAboutCheckUpdate"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PillButton}"
                                Content="Check for updates"/>
                        <!-- v0.6.54: feedback button. Opens a prefilled
                             GitHub issue in the user's browser so any
                             "I wish Underlit could..." thoughts have a
                             zero-friction path to the developer. -->
                        <Button x:Name="BtnAboutFeedback"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PillButton}"
                                Content="Send feedback"
                                ToolTip="Tell the developer what you wish Underlit did. Opens a prefilled GitHub issue in your browser - no account needed to read, sign in to send."/>
                        <!-- v0.6.56: donate button. -->
                        <Button x:Name="BtnAboutDonate"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PillButton}"
                                Content="Donate"
                                ToolTip="Support development. Opens the project's sponsorship page in your browser."/>
                        <TextBlock x:Name="LblAboutUpdateStatus"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.TextSecondary}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="NavList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectedIndex="0"
                         ItemContainerStyle="{StaticResource SidebarItem}">
                    <!-- v0.6.48: reordered for friendlier UX. Schedule first
                         (the headline feature), Hotkeys next (the user has
                         to know how to drive the app), then Lights, Monitors,
                         Exclusions. General lives at the bottom because it's
                         the catch-all "everything else" page. -->
                    <ListBoxItem Content="Schedule"/>
                    <ListBoxItem Content="Hotkeys"/>
                    <ListBoxItem Content="Lights"/>
                    <ListBoxItem Content="Monitors"/>
                    <ListBoxItem Content="Exclusions"/>
                    <ListBoxItem Content="General"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <ScrollViewer x:Name="MainContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnSmoothScroll"
                          Padding="32,28,32,32">
                <Grid>
                    <!-- GENERAL -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Style="{StaticResource PageTitle}" Text="General"/>

                        <TextBlock Style="{StaticResource CardCaption}" Text="BEHAVIOR"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- v0.6.56: simplified row. Autostart now
                                     self-heals on every launch (registry +
                                     scheduled task), so the explicit Repair
                                     button isn't needed. Status copy lives
                                     on the row's tooltip - the tooltip text
                                     is set in code by RefreshAutoStartStatus(). -->
                                <Grid x:Name="AutoStartRow" Style="{StaticResource Row}"
                                      ToolTipService.InitialShowDelay="350"
                                      ToolTipService.BetweenShowDelay="250"
                                      ToolTipService.ShowDuration="12000">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Start with Windows"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkStartWithWindows" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Disable Windows Night Light"/>
                                        <TextBlock Style="{StaticResource RowHint}" Text="Prevents Windows' built-in warmth from conflicting with Underlit's."/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkDisableNightLight" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                                <!-- "Hook Fn brightness keys" toggle removed in v0.6.12 — the underlying
                                     low-level hook was matching the wrong VK codes (volume up + media next
                                     instead of brightness) and was silently stealing those keys. The hook
                                     is now a no-op regardless of this setting. The CheckBox stays in the
                                     visual tree (Collapsed) so existing code-behind references still bind. -->
                                <CheckBox x:Name="ChkHookNativeKeys" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- v0.6.56: auto Windows theme switching. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="WINDOWS THEME"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Switch Windows light/dark theme automatically"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="Underlit follows the schedule's current warmth - cooler than the threshold = light theme, warmer = dark theme. Re-applied at startup, on every warmth change, and every 30 seconds, so other tools / Windows quirks can't outlast it."/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkAutoTheme" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Light/dark threshold"/>
                                    <Slider Grid.Column="1" x:Name="SldAutoThemeThreshold"
                                            Style="{StaticResource AppleSlider}"
                                            Minimum="2200" Maximum="6500"
                                            SmallChange="100" LargeChange="500"
                                            IsSnapToTickEnabled="True" TickFrequency="100"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}"
                                               x:Name="LblAutoThemeThreshold"/>
                                </Grid>
                                <!-- v0.6.63: per-mode wallpaper / solid
                                     colour. Light mode and dark mode each
                                     get a None / Image / Solid Colour
                                     choice, an image-file picker, and a
                                     colour swatch. Applied alongside the
                                     theme switch. -->
                                <Border Style="{StaticResource RowDivider}"/>
                                <TextBlock Style="{StaticResource RowLabel}"
                                           Margin="0,12,0,4"
                                           Text="Light-mode background"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CboLightBgChoice" Grid.Column="0"
                                              Margin="0,0,8,0" MinWidth="140">
                                        <ComboBoxItem Content="Don't change"/>
                                        <ComboBoxItem Content="Image"/>
                                        <ComboBoxItem Content="Solid colour"/>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" x:Name="TxtLightBgImagePath"
                                             Margin="0,0,8,0"
                                             Padding="6,4"
                                             Background="#22FFFFFF"
                                             Foreground="{DynamicResource App.TextPrimary}"
                                             BorderBrush="{DynamicResource App.CardBorder}"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Path to the image file used as the light-mode wallpaper. Use Browse to pick one."/>
                                    <Button Grid.Column="2" x:Name="BtnLightBgBrowse"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource PillButton}"
                                            Content="Browse..."/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource RowLabel}"
                                               Text="Solid colour"/>
                                    <Button Grid.Column="1" x:Name="BtnLightBgColor"
                                            Style="{StaticResource IconButton}"
                                            Padding="2"
                                            ToolTip="Solid background colour for light mode.">
                                        <Border x:Name="LightBgColorSwatch"
                                                Width="36" Height="22" CornerRadius="4"
                                                BorderBrush="{DynamicResource App.CardBorder}"
                                                BorderThickness="1"/>
                                    </Button>
                                </Grid>

                                <Border Style="{StaticResource RowDivider}"/>
                                <TextBlock Style="{StaticResource RowLabel}"
                                           Margin="0,12,0,4"
                                           Text="Dark-mode background"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CboDarkBgChoice" Grid.Column="0"
                                              Margin="0,0,8,0" MinWidth="140">
                                        <ComboBoxItem Content="Don't change"/>
                                        <ComboBoxItem Content="Image"/>
                                        <ComboBoxItem Content="Solid colour"/>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" x:Name="TxtDarkBgImagePath"
                                             Margin="0,0,8,0"
                                             Padding="6,4"
                                             Background="#22FFFFFF"
                                             Foreground="{DynamicResource App.TextPrimary}"
                                             BorderBrush="{DynamicResource App.CardBorder}"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Path to the image file used as the dark-mode wallpaper."/>
                                    <Button Grid.Column="2" x:Name="BtnDarkBgBrowse"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource PillButton}"
                                            Content="Browse..."/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource RowLabel}"
                                               Text="Solid colour"/>
                                    <Button Grid.Column="1" x:Name="BtnDarkBgColor"
                                            Style="{StaticResource IconButton}"
                                            Padding="2"
                                            ToolTip="Solid background colour for dark mode.">
                                        <Border x:Name="DarkBgColorSwatch"
                                                Width="36" Height="22" CornerRadius="4"
                                                BorderBrush="{DynamicResource App.CardBorder}"
                                                BorderThickness="1"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- v0.6.55: wind-down notifications. Opt-in by
                             default. When the toggle is on, the minutes-
                             before-bedtime slider + message textbox govern
                             a tray balloon that fires once per day. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="WIND-DOWN REMINDER"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Notify me before bedtime"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="Underlit pops a small tray notification at the configured time relative to your bedtime - a gentle nudge to start winding down."/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkWindDownEnabled"
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Minutes before bedtime"/>
                                    <Slider Grid.Column="1" x:Name="SldWindDownMinutes"
                                            Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="120"
                                            SmallChange="5" LargeChange="15"
                                            IsSnapToTickEnabled="True" TickFrequency="5"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}"
                                               x:Name="LblWindDownMinutes"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Notification text"/>
                                    <TextBox Grid.Column="1" x:Name="TxtWindDownMessage"
                                             Margin="0,0,14,0"
                                             Padding="8,6"
                                             Background="#22FFFFFF"
                                             Foreground="{DynamicResource App.TextPrimary}"
                                             BorderBrush="{DynamicResource App.CardBorder}"
                                             BorderThickness="1"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardCaption}" Text="STEP SIZES"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Brightness per keypress"/>
                                    <Slider Grid.Column="1" x:Name="SldBrightnessStep" Style="{StaticResource AppleSlider}"
                                            Minimum="1" Maximum="20" TickFrequency="1"
                                            IsSnapToTickEnabled="True" SmallChange="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblBrightnessStep"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Warmth per keypress"/>
                                    <Slider Grid.Column="1" x:Name="SldWarmthStep" Style="{StaticResource AppleSlider}"
                                            Minimum="50" Maximum="600" TickFrequency="50"
                                            IsSnapToTickEnabled="True" SmallChange="50"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblWarmthStep"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardCaption}" Text="ANIMATION"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Software fade duration"/>
                                        <TextBlock Style="{StaticResource RowHint}" Text="Smooths the overlay fade. Hardware brightness always snaps."/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" x:Name="SldRampDuration" Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="400" TickFrequency="20" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblRampDuration"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardCaption}" Text="APPEARANCE"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Follow Windows accent color"/>
                                    <CheckBox Grid.Column="1" x:Name="ChkFollowAccent" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Custom accent color"/>
                                    <Button Grid.Column="1" x:Name="BtnPickAccent" Margin="0,0,14,0" Padding="6"
                                            Cursor="Hand" Background="Transparent" BorderThickness="0">
                                        <Border x:Name="AccentSwatch"
                                                Width="32" Height="22" CornerRadius="4"
                                                BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                                    </Button>
                                </Grid>
                                <!-- v0.6.69: user-pickable sun (brightness) icon colour. -->
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Sun icon color"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="Colour of the brightness icon in the OSD pill. Defaults to amber (#FEC80F); set to whatever reads well against your usual backdrop."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnPickSunIcon" Margin="0,0,14,0" Padding="6"
                                            Cursor="Hand" Background="Transparent" BorderThickness="0">
                                        <Border x:Name="SunIconSwatch"
                                                Width="32" Height="22" CornerRadius="4"
                                                BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                                    </Button>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Transparency effects"/>
                                        <TextBlock Style="{StaticResource RowHint}" Text="Acrylic blur behind the OSD. Auto follows your Windows transparency setting."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="CboTransparency"
                                              Margin="0,0,14,0" MinWidth="100">
                                        <ComboBoxItem Content="Auto"/>
                                        <ComboBoxItem Content="On"/>
                                        <ComboBoxItem Content="Off"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Backdrop style"/>
                                        <TextBlock Style="{StaticResource RowHint}" Text="None = solid tint. Acrylic = live frosted blur. Liquid Glass adds an Apple-style highlight on top of acrylic."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="CboBackdrop"
                                              Margin="0,0,14,0" MinWidth="120">
                                        <ComboBoxItem Content="Solid"/>
                                        <ComboBoxItem Content="Subtle"/>
                                        <ComboBoxItem Content="Liquid Glass"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Bar style"/>
                                        <TextBlock Style="{StaticResource RowHint}" Text="Bar = thin slider with a partial fill (current default). Solid fill = the bar column fills with a tall pill-shaped block whose width tracks the level. Applies to both brightness and warmth."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="CboBarStyle"
                                              Margin="0,0,14,0" MinWidth="120">
                                        <ComboBoxItem Content="Bar"/>
                                        <ComboBoxItem Content="Solid fill"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Distance above taskbar"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="How far the OSD pill sits above the taskbar's top edge. Higher values lift the OSD farther from the screen edge."/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" x:Name="SldOsdGap" Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="200" TickFrequency="10"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblOsdGap"/>
                                </Grid>
                                <!-- v0.6.71: bar right inset slider. -->
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Bar inset (right)"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="Right-side padding between the brightness/warmth bar and the pill's right edge. Smaller value = wider bar."/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" x:Name="SldOsdBarInset" Style="{StaticResource AppleSlider}"
                                            Minimum="12" Maximum="120" TickFrequency="4" SmallChange="2"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblOsdBarInset"/>
                                </Grid>
