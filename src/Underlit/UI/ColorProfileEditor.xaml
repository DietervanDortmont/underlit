<Window x:Class="Underlit.UI.ColorProfileEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colour profile"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF1C1C1E"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Foreground="White"
        UseLayoutRounding="True">
    <!-- v0.6.58: edit one LightColorGroup. -->
    <Window.Resources>
        <SolidColorBrush x:Key="CPE.CardBorder" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="CPE.TextDim"    Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="CPE.ButtonBg"   Color="#FFE5E5EA"/>
        <SolidColorBrush x:Key="CPE.ButtonFg"   Color="#FF1A1A1C"/>

        <Style x:Key="CPEButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CPE.ButtonBg}"/>
            <Setter Property="Foreground" Value="{StaticResource CPE.ButtonFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CPESecondaryButton" TargetType="Button" BasedOn="{StaticResource CPEButton}">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CPELabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CPECaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CPE.TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LblTitle"
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"
                   Text="New colour profile"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CPELabel}" Text="Name"/>
                    <TextBox Grid.Column="1" x:Name="TxtName"
                             Padding="8,6"
                             Background="#22FFFFFF"
                             Foreground="White"
                             BorderBrush="{StaticResource CPE.CardBorder}"
                             BorderThickness="1"/>
                </Grid>

                <TextBlock Style="{StaticResource CPECaption}" Text="TIMING"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CPELabel}" Text="Time offset"/>
                    <Slider Grid.Column="1" x:Name="SldOffset"
                            Minimum="-120" Maximum="120"
                            SmallChange="5" LargeChange="15"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="LblOffset"
                               Style="{StaticResource CPELabel}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock FontSize="11" Foreground="{StaticResource CPE.TextDim}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Negative = this profile fires that many minutes EARLIER than the schedule. Positive = LATER. Lets you stagger the dimming across rooms."/>

                <TextBlock Style="{StaticResource CPECaption}" Text="TARGETS"/>
                <TextBlock FontSize="11" Foreground="{StaticResource CPE.TextDim}"
                           TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Pick which Hue groups or individual lights this profile drives. Lights you don't tick stay on the default schedule."/>
                <Border Background="#11FFFFFF" CornerRadius="6" Padding="10" MaxHeight="240">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Groups" FontWeight="SemiBold" Foreground="{StaticResource CPE.TextDim}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="LstTargetGroups" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Foreground="White" Margin="0,2"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Lights" FontWeight="SemiBold" Foreground="{StaticResource CPE.TextDim}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="LstTargetLights">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Foreground="White" Margin="0,2"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <TextBlock Style="{StaticResource CPECaption}" Text="GRADIENT"/>
                <TextBlock FontSize="11" Foreground="{StaticResource CPE.TextDim}"
                           TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Replaces the screen-warmth scale for this profile's bulbs. Each stop is (kelvin, colour). Black stops mean 'bulb off at that warmth'. Kelvin values within 100 K of a schedule anchor will snap to the anchor. Leave empty to inherit the global gradient."/>
                <TextBlock x:Name="LblAnchorList"
                           FontSize="11" FontStyle="Italic"
                           Foreground="{StaticResource CPE.TextDim}"
                           Margin="0,0,0,6"
                           Text="Schedule anchors:"/>
                <Border BorderBrush="{StaticResource CPE.CardBorder}" BorderThickness="1" CornerRadius="4">
                    <Rectangle x:Name="GradientPreviewBar" Height="22"/>
                </Border>
                <ItemsControl x:Name="LstGradientStops" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Padding="6,4"
                                         Background="#22FFFFFF"
                                         Foreground="White"
                                         BorderBrush="{StaticResource CPE.CardBorder}"
                                         BorderThickness="1"
                                         TextAlignment="Center"
                                         Text="{Binding Kelvin, Mode=OneWay}"
                                         LostFocus="OnGradientStopKelvinLostFocus"
                                         KeyDown="OnGradientStopKelvinKeyDown"
                                         Tag="{Binding}"/>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource CPELabel}"
                                           Margin="6,0,8,0"
                                           Text="K"/>
                                <Border Grid.Column="2"
                                        Width="36" Height="22"
                                        CornerRadius="3"
                                        BorderBrush="{StaticResource CPE.CardBorder}"
                                        BorderThickness="1"
                                        Background="{Binding Swatch}"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        MouseLeftButtonUp="OnGradientStopSwatchClicked"/>
                                <Button Grid.Column="4"
                                        Style="{StaticResource CPESecondaryButton}"
                                        MinWidth="0"
                                        Padding="10,2"
                                        Margin="6,0,4,0"
                                        Content="Off"
                                        Tag="{Binding}"
                                        Click="OnGradientStopMakeBlackClicked"
                                        ToolTip="Set this stop's colour to pure black so the bulb turns off at this warmth."/>
                                <Button Grid.Column="5"
                                        Style="{StaticResource CPESecondaryButton}"
                                        MinWidth="0"
                                        Padding="10,2"
                                        Content="✕"
                                        Tag="{Binding}"
                                        Click="OnGradientStopRemoveClicked"
                                        ToolTip="Remove this stop."/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnAddStop"
                            Style="{StaticResource CPESecondaryButton}"
                            MinWidth="0"
                            Padding="12,4"
                            Content="+ Add stop"/>
                    <Button x:Name="BtnResetToSchedule"
                            Style="{StaticResource CPESecondaryButton}"
                            MinWidth="0"
                            Padding="12,4"
                            Margin="6,0,0,0"
                            Content="Reset to schedule"
                            ToolTip="Replace the gradient with stops at every schedule anchor kelvin, with sensible default colours."/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Margin="0,0,8,0" Style="{StaticResource CPESecondaryButton}" Content="Cancel"/>
            <Button x:Name="BtnSave"   Style="{StaticResource CPEButton}" Content="Save"/>
        </StackPanel>
    </Grid>
</Window>
