<Window x:Class="Underlit.UI.QuickSceneEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Scene"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF1C1C1E"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Foreground="White"
        UseLayoutRounding="True">
    <!--
        v0.6.55: modal editor for one custom Quick Scene. Self-contained
        dark palette so it renders correctly without depending on the
        SettingsWindow's runtime-generated theme brushes.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="QSE.CardBg"     Color="#FF242427"/>
        <SolidColorBrush x:Key="QSE.CardBorder" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="QSE.TextDim"    Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="QSE.ButtonBg"   Color="#FFE5E5EA"/>
        <SolidColorBrush x:Key="QSE.ButtonFg"   Color="#FF1A1A1C"/>

        <Style x:Key="QSEButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource QSE.ButtonBg}"/>
            <Setter Property="Foreground" Value="{StaticResource QSE.ButtonFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QSESecondaryButton" TargetType="Button" BasedOn="{StaticResource QSEButton}">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="QSELabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="QSEHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource QSE.TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border Padding="24,20">
        <StackPanel>
            <TextBlock x:Name="LblTitle"
                       FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,16"
                       Text="New Quick Scene"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource QSELabel}" Text="Name"/>
                <TextBox Grid.Column="1" x:Name="TxtName"
                         Padding="8,6"
                         Background="#22FFFFFF"
                         Foreground="White"
                         BorderBrush="{StaticResource QSE.CardBorder}"
                         BorderThickness="1"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource QSELabel}" Text="Action"/>
                <ComboBox Grid.Column="1" x:Name="CboAction"
                          Padding="8,4">
                    <ComboBoxItem Content="Set warmth + brightness"/>
                    <ComboBoxItem Content="Turn off"/>
                    <ComboBoxItem Content="Resume schedule"/>
                </ComboBox>
            </Grid>

            <!-- Warmth/brightness only relevant for Set action; greyed
                 otherwise. -->
            <Grid x:Name="WarmthRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource QSELabel}" Text="Warmth"/>
                <Slider Grid.Column="1" x:Name="SldKelvin"
                        Minimum="1500" Maximum="6500"
                        SmallChange="100" LargeChange="500"
                        IsSnapToTickEnabled="True" TickFrequency="100"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="LblKelvin"
                           Style="{StaticResource QSELabel}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Grid x:Name="BrightnessRow" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource QSELabel}" Text="Brightness"/>
                <Slider Grid.Column="1" x:Name="SldBri"
                        Minimum="1" Maximum="100"
                        SmallChange="5" LargeChange="20"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="LblBri"
                           Style="{StaticResource QSELabel}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Style="{StaticResource QSEHint}"
                       Margin="0,0,0,16"
                       Text="The scene applies to whichever groups, lights and plugs are currently ticked in the Lights settings page. Underlit then leaves those lights alone, the same as when Google Home changes them, until they're switched off or you pick Resume lights schedule in the tray menu."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Margin="0,0,8,0"
                        Style="{StaticResource QSESecondaryButton}"
                        Content="Cancel"/>
                <Button x:Name="BtnSave"
                        Style="{StaticResource QSEButton}"
                        Content="Save"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
