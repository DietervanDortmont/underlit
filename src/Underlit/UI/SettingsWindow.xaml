                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="OSD shadow opacity"/>
                                    <Slider Grid.Column="1" x:Name="SldOsdShadowOpacity" Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="100" TickFrequency="5" SmallChange="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblOsdShadowOpacity"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="OSD shadow blur"/>
                                    <Slider Grid.Column="1" x:Name="SldOsdShadowBlur" Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="60" TickFrequency="2" SmallChange="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblOsdShadowBlur"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="OSD shadow offset"/>
                                    <Slider Grid.Column="1" x:Name="SldOsdShadowOffset" Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="30" TickFrequency="1" SmallChange="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblOsdShadowOffset"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="OSD shadow angle"/>
                                    <Slider Grid.Column="1" x:Name="SldOsdShadowAngle" Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="359" TickFrequency="15" SmallChange="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblOsdShadowAngle"/>
                                </Grid>
                                <!-- v0.6.64: spread / size. Grows the source pill outward
                                     before blur, giving a beefier halo without smear. -->
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="OSD shadow size"
                                               ToolTip="Grows the shadow's source pill outward before the blur is applied (CSS box-shadow 'spread'). Use this for a beefier halo when cranking up Blur alone makes the shadow look smeary."/>
                                    <Slider Grid.Column="1" x:Name="SldOsdShadowSpread" Style="{StaticResource AppleSlider}"
                                            Minimum="0" Maximum="60" TickFrequency="2" SmallChange="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblOsdShadowSpread"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BAR COLOUR — split at the 50 mark: accent above, dim shade below. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="BAR COLOUR"/>
                        <Border Style="{StaticResource Card}">
