<Window x:Class="Underlit.UI.RoutineEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Routine"
        Width="520" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FF1C1C1E"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        Foreground="White"
        UseLayoutRounding="True">
    <!-- v0.6.55: edit one Routine. Self-contained dark palette. -->
    <Window.Resources>
        <SolidColorBrush x:Key="RE.CardBorder" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="RE.TextDim"    Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="RE.ButtonBg"   Color="#FFE5E5EA"/>
        <SolidColorBrush x:Key="RE.ButtonFg"   Color="#FF1A1A1C"/>

        <Style x:Key="REButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RE.ButtonBg}"/>
            <Setter Property="Foreground" Value="{StaticResource RE.ButtonFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RESecondaryButton" TargetType="Button" BasedOn="{StaticResource REButton}">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RELabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RECaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource RE.TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LblTitle"
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8" Text="New routine"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Name -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RELabel}" Text="Name"/>
                    <TextBox Grid.Column="1" x:Name="TxtName"
                             Padding="8,6"
                             Background="#22FFFFFF"
                             Foreground="White"
                             BorderBrush="{StaticResource RE.CardBorder}"
                             BorderThickness="1"/>
                </Grid>

                <!-- Trigger -->
                <TextBlock Style="{StaticResource RECaption}" Text="WHEN"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RELabel}" Text="Trigger"/>
                    <ComboBox Grid.Column="1" x:Name="CboTriggerKind" Padding="8,4">
                        <ComboBoxItem Content="Wall-clock time"/>
                        <ComboBoxItem Content="Relative to wake time"/>
                        <ComboBoxItem Content="Relative to bedtime"/>
                    </ComboBox>
                </Grid>

                <Grid x:Name="AbsoluteTimeRow" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RELabel}" Text="Time"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="TxtTriggerHour"   Width="44" Padding="6,4" Background="#22FFFFFF" Foreground="White" BorderBrush="{StaticResource RE.CardBorder}" BorderThickness="1" TextAlignment="Center"/>
                        <TextBlock Style="{StaticResource RELabel}" Margin="6,0,6,0" Text=":"/>
                        <TextBox x:Name="TxtTriggerMinute" Width="44" Padding="6,4" Background="#22FFFFFF" Foreground="White" BorderBrush="{StaticResource RE.CardBorder}" BorderThickness="1" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="RelativeOffsetRow" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RELabel}" Text="Offset (min)"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="TxtOffsetMinutes" Width="80" Padding="6,4" Background="#22FFFFFF" Foreground="White" BorderBrush="{StaticResource RE.CardBorder}" BorderThickness="1" TextAlignment="Center"/>
                        <TextBlock Style="{StaticResource RELabel}" Margin="8,0,0,0"
                                   Text="(negative = before, positive = after)"
                                   Foreground="{StaticResource RE.TextDim}"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Days -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RELabel}" Text="Days"/>
                    <WrapPanel Grid.Column="1">
                        <CheckBox x:Name="ChkMon" Content="Mon" Foreground="White" Margin="0,0,12,4"/>
                        <CheckBox x:Name="ChkTue" Content="Tue" Foreground="White" Margin="0,0,12,4"/>
                        <CheckBox x:Name="ChkWed" Content="Wed" Foreground="White" Margin="0,0,12,4"/>
                        <CheckBox x:Name="ChkThu" Content="Thu" Foreground="White" Margin="0,0,12,4"/>
                        <CheckBox x:Name="ChkFri" Content="Fri" Foreground="White" Margin="0,0,12,4"/>
                        <CheckBox x:Name="ChkSat" Content="Sat" Foreground="White" Margin="0,0,12,4"/>
                        <CheckBox x:Name="ChkSun" Content="Sun" Foreground="White" Margin="0,0,12,4"/>
                    </WrapPanel>
                </Grid>

                <!-- Action -->
                <TextBlock Style="{StaticResource RECaption}" Text="WHAT"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RELabel}" Text="Action"/>
                    <ComboBox Grid.Column="1" x:Name="CboAction" Padding="8,4">
                        <ComboBoxItem Content="Turn on"/>
                        <ComboBoxItem Content="Turn off"/>
                        <ComboBoxItem Content="Turn on for N minutes, then off"/>
                    </ComboBox>
                </Grid>
                <Grid x:Name="DurationRow" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RELabel}" Text="Duration (min)"/>
                    <TextBox Grid.Column="1" x:Name="TxtDurationMinutes"
                             Width="80" HorizontalAlignment="Left"
                             Padding="6,4" Background="#22FFFFFF" Foreground="White"
                             BorderBrush="{StaticResource RE.CardBorder}" BorderThickness="1"
                             TextAlignment="Center"/>
                </Grid>

                <!-- Targets -->
                <TextBlock Style="{StaticResource RECaption}" Text="TARGETS"/>
                <TextBlock FontSize="11" Foreground="{StaticResource RE.TextDim}"
                           TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Pick which lights, plugs, or groups this routine acts on."/>
                <Border Background="#11FFFFFF" CornerRadius="6" Padding="10" MaxHeight="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Groups" FontWeight="SemiBold" Foreground="{StaticResource RE.TextDim}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="LstTargetGroups" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Foreground="White" Margin="0,2"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Lights" FontWeight="SemiBold" Foreground="{StaticResource RE.TextDim}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="LstTargetLights" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Foreground="White" Margin="0,2"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Plugs" FontWeight="SemiBold" Foreground="{StaticResource RE.TextDim}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="LstTargetPlugs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Foreground="White" Margin="0,2"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Margin="0,0,8,0" Style="{StaticResource RESecondaryButton}" Content="Cancel"/>
            <Button x:Name="BtnSave"   Style="{StaticResource REButton}" Content="Save"/>
        </StackPanel>
    </Grid>
</Window>
