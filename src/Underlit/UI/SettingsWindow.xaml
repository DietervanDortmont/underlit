                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}"
                                               Text="{Binding ElementName=SldGlassRimSecondary, Path=Value, StringFormat={}{0:F0}%}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- v0.6.48: emergency reset. Wipes settings.json and
                             reloads from defaults so a borked configuration
                             can be recovered without editing files manually. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="RESET"/>
                        <Border Style="{StaticResource Card}">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Restore all defaults"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Wipes every setting and reloads the factory configuration. Hotkeys, schedule profiles, Hue pairing, monitor offsets, and exclusions are all reset. There is no undo."/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnRestoreDefaults"
                                        Margin="0,0,16,0"
                                        Style="{StaticResource PillButton}"
                                        Content="Restore"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- HOTKEYS -->
                    <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Hotkeys"/>
                        <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,16"
                                   Text="Click a field and press the key combination you want. Esc cancels, Backspace clears. Bindings need at least one modifier (Ctrl, Alt, Shift, or Win) so a single key isn't hijacked system-wide."/>

                        <TextBlock Style="{StaticResource CardCaption}" Text="BRIGHTNESS"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Brightness down"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkBrDown" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Brightness up"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkBrUp" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardCaption}" Text="WARMTH"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Warmer"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkWrDown" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Cooler"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkWrUp" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardCaption}" Text="PHILIPS HUE"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Hue brightness down"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkHueBrDown" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Hue brightness up"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkHueBrUp" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Hue warmer"/>
                                        <TextBlock Style="{StaticResource RowHint}" Text="Subtracts from the warmth offset (lights drift toward warmer)."/>
                                    </StackPanel>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkHueWrDown" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Hue cooler"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkHueWrUp" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardCaption}" Text="OTHER"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Boost"/>
                                        <TextBlock Style="{StaticResource RowHint}" Text="Toggle: once jumps to full, again restores."/>
                                    </StackPanel>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkBoost" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Toggle Underlit on/off"/>
                                    <ui:HotkeyField Grid.Column="1" x:Name="TxtHkToggle" MinWidth="220" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SCHEDULE -->
                    <StackPanel x:Name="PageSchedule" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Schedule"/>

                        <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,12"
                                   Text="On: Underlit follows the day to night curve below. Your screen warms in the evening and resets to neutral in the morning, applied immediately on launch. Off: you control warmth manually with hotkeys, and whatever you set persists until you change it."/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Warmth follows a schedule"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="Override automatically every 30 seconds while running."/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="ChkScheduleEnabled" Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Schedule curve cards — dimmed/disabled when the toggle above is off so the
                             user gets a clear signal that they're inert in manual mode. IsEnabled
                             binding handles the disable state; Opacity binding handles the visual cue. -->
                        <StackPanel x:Name="SchedulePanelCurve"
                                    IsEnabled="{Binding ElementName=ChkScheduleEnabled, Path=IsChecked}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ChkScheduleEnabled, Path=IsChecked}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                        <!-- ====== PROFILE PICKER ======
                             Apple-style: a thin pill row with the active profile in a dropdown,
                             flanked by + (clone current → new profile) and − (delete; disabled
                             on the built-in "Recommended" profile). The profile drives the
                             Bedtime / WakeTime / Night warmth values below. Switching profiles
                             instantly retargets the curve. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="PROFILE"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center" Margin="14,0,8,0">
                                        <ComboBox x:Name="CboProfile"
                                                  VerticalAlignment="Center"
                                                  MinWidth="200"
                                                  IsEditable="False"/>
                                        <TextBox x:Name="TxtProfileRename"
                                                 Style="{StaticResource AppleTextBox}"
                                                 Visibility="Collapsed"
                                                 Margin="0"
                                                 HorizontalAlignment="Stretch"
                                                 TextAlignment="Left"
                                                 HorizontalContentAlignment="Left"/>
                                    </Grid>
                                    <Button Grid.Column="1" x:Name="BtnRenameProfile"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Rename this profile">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource App.TextPrimary}"
                                                   Text="&#xE70F;"/>
                                    </Button>
                                    <Button Grid.Column="2" x:Name="BtnAddProfile"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Clone current profile to a new one">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource App.TextPrimary}"
                                                   Text="&#xE710;"/>
                                    </Button>
                                    <Button Grid.Column="3" x:Name="BtnRemoveProfile"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Delete this profile">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource App.TextPrimary}"
                                                   Text="&#xE738;"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ====== DAY/NIGHT CURVE (read-only graph, derived from Bedtime + WakeTime) ======
                             Drag-to-edit landed in v0.6.23+ as a planned follow-up; for now the
                             curve is auto-derived from the active profile's two anchor times via
                             the circadian-physiology model. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="DAY/NIGHT CURVE"/>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <Grid Margin="14,12,14,8" Height="120">
                                    <Canvas x:Name="ScheduleGraph" ClipToBounds="True"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <!-- v0.6.53: 24h cycle simulator. Walks through a
                                     full schedule day in 15 seconds, pushing the
                                     synthesized warmth to the engine + Hue lights
                                     so the user can see exactly how their curve
                                     looks at every hour without waiting all day. -->
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Simulate 24h cycle"/>
                                        <!-- v0.6.56: status only appears
                                             during simulation. The default
                                             explanation is now a tooltip
                                             on the Simulate button. -->
                                        <TextBlock x:Name="LblSimulateStatus"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   Visibility="Collapsed"
                                                   Text=""/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnSimulateCycle"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PillButton}"
                                            Content="Simulate"
                                            ToolTip="Plays a full day's worth of warmth changes through your screen and Hue lights in about 10 seconds. Click anywhere on the graph during playback to jump to that time."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ====== TIMES — four independently editable anchors ======
                             Each of the four schedule anchors (evening-ramp start, bedtime,
                             morning-ramp start, wake) is an independent time. Editing any
                             one of them does NOT shift the others — that includes dragging
                             the corresponding point on the graph. To keep the bedtime ramp
                             at a particular length you adjust BOTH "Evening ramp starts"
                             and "Bedtime", same for the morning side. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="TIMES"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Evening ramp starts"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="When the screen begins shifting from neutral toward bedtime warmth."/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="TxtBedtimeStart" Style="{StaticResource AppleTextBox}" Width="80" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Bedtime"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="When deep warmth is fully reached. Independent of the ramp-start time above."/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="TxtBedtime" Style="{StaticResource AppleTextBox}" Width="80" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Morning ramp starts"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="When the screen begins shifting from bedtime warmth back toward neutral."/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="TxtWakeupStart" Style="{StaticResource AppleTextBox}" Width="80" Margin="0,0,14,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Wake time"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="When neutral is fully reached. Independent of the ramp-start time above."/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="TxtWakeTime" Style="{StaticResource AppleTextBox}" Width="80" Margin="0,0,14,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource CardCaption}" Text="NIGHT WARMTH"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Warmth at night (K)"/>
                                    <Slider Grid.Column="1" x:Name="SldNightWarmth" Style="{StaticResource AppleSlider}"
                                            Minimum="1500" Maximum="6500" TickFrequency="100" IsSnapToTickEnabled="True"/>
                                    <!-- Live preview: shows the actual screen tint produced at the
                                         selected kelvin, updated as the user drags the slider. -->
                                    <Border Grid.Column="2" x:Name="NightWarmthPreview"
                                            Margin="8,0,8,0" Width="32" Height="22" CornerRadius="4"
                                            BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"
                                            ToolTip="Preview of the screen tint at this kelvin"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource ValueChip}" x:Name="LblNightWarmth"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        </StackPanel>  <!-- /SchedulePanelCurve -->
                    </StackPanel>

                    <!-- LIGHTS — Philips Hue integration -->
                    <StackPanel x:Name="PageLights" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Lights"/>

                        <!-- v0.6.48: lead with a clear opt-out so users
                             without Hue gear know they can ignore this page. -->
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.TextPrimary}"
                                   Text="Connect a Philips Hue Bridge so your room lighting follows Underlit's circadian schedule."/>
                        <TextBlock Margin="0,0,0,16"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.TextSecondary}"
                                   Text="Don't have Philips Hue? You can skip this entire page. Underlit isn't affiliated with Signify or Philips."/>

                        <!-- DISCONNECTED: discovery + manual IP entry -->
                        <StackPanel x:Name="HuePanelDisconnected" Visibility="Collapsed">
                            <!-- v0.6.54: walkthrough card. Three numbered
                                 steps so first-time users know what's about
                                 to happen rather than facing four buttons
                                 with no narrative. -->
                            <TextBlock Style="{StaticResource CardCaption}" Text="GETTING STARTED"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Margin="0,2,0,2">
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.TextPrimary}"
                                               Margin="0,0,0,8"
                                               Text="Connect Underlit to your Hue Bridge in three steps:"/>
                                    <TextBlock FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               Margin="0,0,0,6"
                                               Text="1. Click Discover below. Underlit asks Philips' service for the IP of any Hue Bridge on your network. (If that fails, type the bridge IP manually - you'll find it in the Hue app under Settings -> My Hue System.)"/>
                                    <TextBlock FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               Margin="0,0,0,6"
                                               Text="2. Press the round button on top of your Hue Bridge - this gives Underlit a 30-second window to authorise itself."/>
                                    <TextBlock FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               Margin="0,0,0,6"
                                               Text="3. Pick which rooms or individual bulbs Underlit should follow. Mixing Hue with IKEA Tradfri is fine - IKEA bulbs that can't reach the schedule's deepest warmth will fade out gracefully."/>
                                    <TextBlock FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               Margin="0,8,0,0"
                                               FontStyle="Italic"
                                               Text="Underlit only ever modifies bulbs you tick. It also respects manual on/off - turn a bulb off via Google Home or a wall switch and Underlit leaves it alone until you turn it back on."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource CardCaption}" Text="FIND YOUR BRIDGE"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="14,12,14,8"
                                               Text="Underlit can locate your bridge via Philips' discovery service, or you can enter its IP directly if you already know it."/>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Auto-discover bridges on your network"/>
                                        <Button Grid.Column="1" x:Name="BtnHueDiscover" Margin="0,0,14,0"
                                                Style="{StaticResource PillButton}" Content="Discover"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Or enter bridge IP manually"/>
                                        <TextBox Grid.Column="1" x:Name="TxtHueManualIp"
                                                 Width="160" Margin="0,0,8,0"
                                                 Padding="6,4"
                                                 ToolTip="e.g. 192.168.1.42"/>
                                        <Button Grid.Column="2" x:Name="BtnHueConnectManual" Margin="0,0,14,0"
                                                Style="{StaticResource PillButton}" Content="Use this"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="HueDiscoveredCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="14,12,14,8"
                                               Text="Bridges found on your network:"/>
                                    <ListBox x:Name="LstHueBridges" Margin="14,0,14,12"
                                             MaxHeight="120" BorderThickness="1"
                                             BorderBrush="{DynamicResource App.CardBorder}"
                                             Background="Transparent"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="LblHueDiscoverStatus"
                                       Style="{StaticResource RowHint}"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- PAIRING: link-button countdown -->
                        <StackPanel x:Name="HuePanelPairing" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CardCaption}" Text="PAIR WITH BRIDGE"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Margin="14,14,14,14">
                                    <TextBlock Style="{StaticResource RowLabel}" Margin="0,0,0,8"
                                               Text="Press the link button on the top of your Hue Bridge"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="It's the round button on the bridge's lid. After you press it you have ~30 seconds to click Pair below."/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblHuePairingStatus"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   FontSize="11"/>
                                        <Button Grid.Column="1" x:Name="BtnHuePairCancel"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PillButton}"
                                                Content="Back"/>
                                        <Button Grid.Column="2" x:Name="BtnHuePair"
                                                Style="{StaticResource PillButton}"
                                                Background="{DynamicResource App.Accent}"
                                                BorderThickness="0"
                                                Foreground="White"
                                                Content="Pair"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- CONNECTED: group selection + colour range + actions -->
                        <StackPanel x:Name="HuePanelConnected" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CardCaption}" Text="BRIDGE"/>
                            <Border Style="{StaticResource Card}">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" x:Name="LblHueBridgeIp" Text="Connected to bridge"/>
                                        <TextBlock Style="{StaticResource RowHint}" x:Name="LblHueBridgeStatus" Text="Reachable"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnHueUnpair" Margin="0,0,14,0"
                                            Style="{StaticResource PillButton}"
                                            Content="Unpair"/>
                                </Grid>
                            </Border>

                            <!-- v0.6.55: grouped tree-flavoured layout.
                                 Each room/zone shows as a section header
                                 with its own toggle (select-all for the
                                 group); member lights sit indented below
                                 with their individual toggles. Plugs and
                                 ungrouped bulbs go in their own sections
                                 below. -->
                            <TextBlock Style="{StaticResource CardCaption}" Text="ROOMS &amp; LIGHTS"/>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="14,12,14,8"
                                               Text="Tick rooms or individual bulbs Underlit should follow. Tick the room header to select every bulb in it at once. The CT range is shown next to each bulb; CT-limited bulbs (e.g. IKEA Tradfri) fade out gracefully when the schedule passes their warmth limit."/>
                                    <ItemsControl x:Name="HueLightsList" Margin="14,4,14,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- We bind a flat list of mixed-kind rows
                                                     (group headers + indented light rows),
                                                     differentiated by the IsHeader flag on
                                                     the row's view-model. Indent is via
                                                     Margin.Left on the inner Grid. -->
                                                <Grid Margin="{Binding RowMargin}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource App.TextPrimary}"
                                                               FontSize="{Binding FontSize}"
                                                               FontWeight="{Binding FontWeight}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <CheckBox Grid.Column="1"
                                                              Style="{StaticResource ToggleSwitch}"
                                                              Margin="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- v0.6.55: smart plugs in their own card so
                                 they can be wired into routines (e.g. SAD
                                 lamp at wake time) without joining the CT
                                 schedule push. -->
                            <TextBlock Style="{StaticResource CardCaption}" Text="SMART PLUGS"/>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="14,12,14,8"
                                               Text="Hue / IKEA on-off plugs found on your bridge. Plugs aren't part of the warmth schedule (they only do on/off) - tick them here to make them available to Quick Scenes and Routines."/>
                                    <ItemsControl x:Name="HuePlugsList" Margin="14,4,14,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource App.TextPrimary}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <CheckBox Grid.Column="1"
                                                              Style="{StaticResource ToggleSwitch}"
                                                              Margin="0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="LblNoPlugs"
                                               Margin="14,0,14,12"
                                               FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               Text="No smart plugs found on your bridge."
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Hidden legacy element. The new HueLightsList
                                 unifies the old GROUPS + INDIVIDUAL LIGHTS
                                 into one tree-style list, but the code-behind
                                 still references HueGroupsList in a couple
                                 of places (e.g. Test selection). Keep an
                                 invisible ItemsControl with the old name so
                                 those references resolve. -->
                            <ItemsControl x:Name="HueGroupsList" Visibility="Collapsed"/>

                            <!-- Refresh + test pill row, shared by both lists. -->
                            <Border Style="{StaticResource Card}">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Refresh groups + lights / test selection"/>
                                    <Button Grid.Column="1" x:Name="BtnHueRefreshGroups"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource PillButton}" Content="Refresh"/>
                                    <Button Grid.Column="2" x:Name="BtnHueTest"
                                            Margin="0,0,14,0"
                                            Style="{StaticResource PillButton}" Content="Test"/>
                                </Grid>
                            </Border>

                            <!-- v0.6.55: quick scenes overhaul. Built-in
                                 + custom scenes share one ItemsControl;
                                 right-click a custom scene for Edit/Delete.
                                 Spacing is via per-button Margin so the
                                 wrap behaviour stays predictable across
                                 window widths. -->
                            <!-- v0.6.75: COLOUR GROUPS card removed. The
                                 colour-group editor was moved INTO the
                                 LIGHTS TIMELINE card below (see GroupsEditorPanel
                                 + BtnAddColorProfile pinned to the bottom-right)
                                 so the user manages groups in the same place
                                 they see their timeline visualisation. -->

                            <TextBlock Style="{StaticResource CardCaption}" Text="QUICK SCENES"/>
                            <Border Style="{StaticResource Card}" Padding="14,12,14,8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,8"
                                               Text="One-click overrides for your selected groups + lights. The schedule resumes at the next tick (~30 seconds) so these are momentary tweaks. Right-click a custom scene to edit or delete it."/>
                                    <!-- v0.6.56: top scenes shown by
                                         default. The rest live in a hidden
                                         WrapPanel that the "Show more"
                                         button reveals. -->
                                    <ItemsControl x:Name="QuickScenesList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Tag="{Binding Id}"
                                                        Margin="0,0,10,10"
                                                        Padding="16,6"
                                                        MinHeight="32"
                                                        Style="{StaticResource PillButton}"
                                                        ToolTip="{Binding Tooltip}"
                                                        Click="OnQuickSceneClicked"
                                                        MouseRightButtonUp="OnQuickSceneRightClicked"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="QuickScenesMoreList" Visibility="Collapsed">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Tag="{Binding Id}"
                                                        Margin="0,0,10,10"
                                                        Padding="16,6"
                                                        MinHeight="32"
                                                        Style="{StaticResource PillButton}"
                                                        ToolTip="{Binding Tooltip}"
                                                        Click="OnQuickSceneClicked"
                                                        MouseRightButtonUp="OnQuickSceneRightClicked"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnAddQuickScene"
                                                Grid.Column="0"
                                                Padding="14,4"
                                                MinHeight="28"
                                                Style="{StaticResource PillButton}"
                                                Content="+ Add scene"
                                                ToolTip="Create a custom Quick Scene with your own kelvin and brightness."/>
                                        <!-- v0.6.57: Show-more pushed to
                                             bottom-right and given a muted
                                             background so it reads as a
                                             secondary control. -->
                                        <Button x:Name="BtnQuickScenesShowMore"
                                                Grid.Column="2"
                                                Padding="12,4"
                                                MinHeight="28"
                                                Background="#22FFFFFF"
                                                Foreground="{DynamicResource App.TextSecondary}"
                                                BorderThickness="0"
                                                FontSize="12"
                                                Cursor="Hand"
                                                Visibility="Collapsed"
                                                Content="Show more"
                                                ToolTip="Reveal the rest of the available scenes (custom + bridge-imported).">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            CornerRadius="14"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- v0.6.57: lights timeline. Per-group
                                 visualisation of how each Hue group's
                                 effective colour changes through the
                                 day. Each row's gradient is constrained
                                 by the most-restrictive bulb in the
                                 group (so an IKEA Tradfri in a mixed
                                 group caps the group's deepest warmth).
                                 Click Simulate to run a vertical
                                 playhead across all rows. -->
                            <TextBlock Style="{StaticResource CardCaption}" Text="LIGHTS TIMELINE"/>
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,8"
                                               Text="A 'profile' is a complete lights timeline (all rows). Switch profiles to swap the whole set of colour-group gradients at once — e.g. one profile for everyday, one for movie nights. The Default profile is built-in; create your own profiles via the + button and rename, delete, or reset them from the same row."/>
                                    <!-- v0.6.73: profile selector + management,
                                         inline at the top of the timeline card
                                         (no separate popup). The active profile's
                                         colour groups drive the timeline rows
                                         below; switching profiles swaps the whole
                                         set in one click. -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   Text="Profile"/>
                                        <ComboBox Grid.Column="1"
                                                  x:Name="CboLightsProfile"
                                                  Margin="0,0,8,0"
                                                  MinWidth="160"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Id"
                                                  ToolTip="Switch between lights timeline profiles. The selected profile's colour groups drive your Hue lights and populate the timeline rows below."/>
                                        <Button Grid.Column="2" x:Name="BtnLightsProfileAdd"
                                                Padding="10,4" MinHeight="28" Margin="0,0,6,0"
                                                Style="{StaticResource PillButton}"
                                                Content="+ New"
                                                ToolTip="Create a new custom profile. Starts as a copy of the currently-selected one so you have something to tweak."/>
                                        <Button Grid.Column="3" x:Name="BtnLightsProfileRename"
                                                Padding="10,4" MinHeight="28" Margin="0,0,6,0"
                                                Style="{StaticResource PillButton}"
                                                Content="Rename"
                                                ToolTip="Rename the current profile."/>
                                        <Button Grid.Column="4" x:Name="BtnLightsProfileDelete"
                                                Padding="10,4" MinHeight="28" Margin="0,0,6,0"
                                                Style="{StaticResource PillButton}"
                                                Content="Delete"
                                                ToolTip="Delete the current profile. Disabled for the built-in Default profile (use Reset for that)."/>
                                        <Button Grid.Column="5" x:Name="BtnLightsProfileReset"
                                                Padding="10,4" MinHeight="28"
                                                Style="{StaticResource PillButton}"
                                                Content="Reset"
                                                ToolTip="Reset the Default profile back to its recommended factory contents. Only available for the built-in Default profile."/>
                                    </Grid>
                                    <!-- v0.7.0: colour source. "Time of day" turns
                                         every row below into an editable 24 h bar
                                         of colour stops. -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" FontSize="12"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   Text="Colour lights by"/>
                                        <ComboBox Grid.Column="1" x:Name="CboHueColorSource"
                                                  HorizontalAlignment="Left" MinWidth="300"
                                                  ToolTip="Screen warmth: lamps follow the screen's warmth curve. Time of day: you place colour stops on a 24-hour clock for each row.">
                                            <ComboBoxItem Content="Screen warmth (follow the screen schedule)"/>
                                            <ComboBoxItem Content="Time of day (colour stops on a 24 h clock)"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock x:Name="LblTimeModeHint"
                                               Style="{StaticResource RowHint}" Margin="0,0,0,8"
                                               Visibility="Collapsed"
                                               Text="Click a bar to add a colour stop. Drag a stop sideways to move it, click it to change its colour, brightness or time. Lights fade from stop to stop."/>
                                    <Canvas x:Name="LightsTimelineCanvas"
                                            Height="260"
                                            ClipToBounds="True"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LblTimelineStatus"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnTimelineSimulate"
                                                Style="{StaticResource PillButton}"
                                                Content="Simulate"
                                                ToolTip="Sweep a vertical playhead across the timeline at the same speed as the Schedule simulator. Lets you see all groups change in lockstep."/>
                                    </Grid>

                                    <!-- v0.7.1: bulbs per row. Drag a chip onto another
                                         row (here or on the timeline bars) to move the
                                         bulb; drop on "New group" to start a group. -->
                                    <StackPanel x:Name="BulbZonesSection" Margin="0,12,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource App.TextSecondary}"
                                                           Text="BULBS"/>
                                                <TextBlock Style="{StaticResource RowHint}"
                                                           Text="Drag a bulb onto another group (or onto its bar above) to move it. The dot shows what the bulb is doing right now. Right-click a row's name above for more options."/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="BtnSplitByBulbType"
                                                    Style="{StaticResource PillButton}"
                                                    Padding="12,4" MinHeight="28" Margin="12,0,0,0"
                                                    Content="Split into colour + white groups"
                                                    ToolTip="Put every bulb Underlit controls into two groups: one for full-colour bulbs and one for white-only bulbs, each with its own colour stops."/>
                                        </Grid>
                                        <StackPanel x:Name="BulbZonesPanel"/>
                                        <Grid x:Name="WhiteFollowRow" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource App.TextPrimary}"
                                                           Text="White-only bulbs fade out"/>
                                                <TextBlock Style="{StaticResource RowHint}"
                                                           Text="They can't make orange or red, so they dim and switch off as the colour moves past warm white. The thin strip under a bar shows them."/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="SldWhiteFollow"
                                                    Style="{StaticResource AppleSlider}" VerticalAlignment="Center"
                                                    Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                                    IsSnapToTickEnabled="True" TickFrequency="5"/>
                                            <TextBlock Grid.Column="2" x:Name="LblWhiteFollow"
                                                       Style="{StaticResource ValueChip}" MinWidth="110"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- v0.7.0: what to do when Google Home / the
                                         Hue app / a switch changes a light. -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.TextPrimary}"
                                                       Text="When Google Home or the Hue app changes a light"/>
                                            <TextBlock Style="{StaticResource RowHint}"
                                                       Text="Underlit stops changing that light right away. Choose when it takes the light back. You can always use Resume lights schedule in the tray menu."/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="CboHueOverrideRelease"
                                                  MinWidth="230" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Until it's switched off"/>
                                            <ComboBoxItem Content="Until the next colour stop"/>
                                            <ComboBoxItem Content="Until I resume it myself"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- v0.6.75: inline colour-group editor.
                                         Lives under the timeline canvas so the
                                         user manages the rows in the same place
                                         they see them visualised. Each row
                                         shows: name, light count, bulb kelvin
                                         range, then inline buttons for Lights
                                         (popup), Edit gradient, Delete. The
                                         "+ Add group" pill pins to the bottom-
                                         right of the card per the user's spec. -->
                                    <Border Margin="0,10,0,0"
                                            Padding="0"
                                            Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,6"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.TextSecondary}"
                                                       Text="COLOUR GROUPS"/>
                                            <ItemsControl x:Name="ColorProfilesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6"
                                                                Padding="12,8"
                                                                Background="#11FFFFFF"
                                                                CornerRadius="8"
                                                                Tag="{Binding Id}"
                                                                MouseRightButtonUp="OnColorProfileRightClicked">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource App.TextPrimary}"/>
                                                                    <TextBlock Text="{Binding Summary}"
                                                                               FontSize="11"
                                                                               Margin="0,2,0,0"
                                                                               Foreground="{DynamicResource App.TextSecondary}"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Padding="10,3" MinHeight="26" Margin="0,0,6,0"
                                                                        Style="{StaticResource PillButton}"
                                                                        Content="Lights"
                                                                        Tag="{Binding Id}"
                                                                        Click="OnColorProfileLightsClicked"
                                                                        ToolTip="Show which bulbs are in this group and the kelvin range they can collectively reach."/>
                                                                <Button Grid.Column="2"
                                                                        Padding="10,3" MinHeight="26" Margin="0,0,6,0"
                                                                        Style="{StaticResource PillButton}"
                                                                        Content="Edit"
                                                                        Tag="{Binding Id}"
                                                                        Click="OnColorProfileEditClicked"
                                                                        ToolTip="Open the gradient editor for this group."/>
                                                                <Button Grid.Column="3"
                                                                        Padding="10,3" MinHeight="26" Margin="0,0,8,0"
                                                                        Style="{StaticResource PillButton}"
                                                                        Content="Delete"
                                                                        Tag="{Binding Id}"
                                                                        Click="OnColorProfileDeleteClicked"
                                                                        ToolTip="Remove this group from the profile. The bulbs revert to the default schedule."/>
                                                                <CheckBox Grid.Column="4"
                                                                          VerticalAlignment="Center"
                                                                          Style="{StaticResource ToggleSwitch}"
                                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="LblNoColorProfiles"
                                                       Margin="0,4,0,8"
                                                       FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource App.TextSecondary}"
                                                       Text="No groups in this profile yet. Use the + button on the right to add one."
                                                       Visibility="Collapsed"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="1"
                                                        x:Name="BtnAddColorProfile"
                                                        Padding="14,4"
                                                        MinHeight="30"
                                                        Style="{StaticResource PillButton}"
                                                        Content="+ Add group"
                                                        ToolTip="Add a new colour group (subset of your bulbs with its own gradient) to the active profile."/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- v0.6.55: time-triggered routines.
                                 Useful primarily for SAD lamps on Hue
                                 plugs ("turn on at wake, off after 25
                                 min") but also for any "lights on at X,
                                 off at Y" automation. -->
                            <TextBlock Style="{StaticResource CardCaption}" Text="ROUTINES"/>
                            <Border Style="{StaticResource Card}" Padding="14,12,14,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,8"
                                               Text="Time-triggered actions on your lights and plugs. Run at a wall-clock time, or relative to your wake or bedtime. Right-click a routine to edit or delete."/>
                                    <ItemsControl x:Name="RoutinesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6"
                                                        Padding="12,8"
                                                        Background="#11FFFFFF"
                                                        CornerRadius="8"
                                                        Tag="{Binding Id}"
                                                        MouseRightButtonUp="OnRoutineRightClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource App.TextPrimary}"/>
                                                            <TextBlock Text="{Binding Summary}"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource App.TextSecondary}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1"
                                                                  Style="{StaticResource ToggleSwitch}"
                                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="LblNoRoutines"
                                               Margin="0,4,0,8"
                                               FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               Text="No routines yet. Use the buttons below to add one."
                                               Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button x:Name="BtnAddRoutine"
                                                Margin="0,0,8,0"
                                                Padding="14,4"
                                                MinHeight="28"
                                                Style="{StaticResource PillButton}"
                                                Content="+ Add routine"
                                                ToolTip="Create a new time-triggered routine."/>
                                        <Button x:Name="BtnAddSadRoutine"
                                                Padding="14,4"
                                                MinHeight="28"
                                                Style="{StaticResource PillButton}"
                                                Content="+ Add SAD-lamp routine"
                                                ToolTip="Pre-filled routine: turn on selected plugs / lights at wake time, off 25 minutes later. Tweak after creation if needed."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource CardCaption}" Text="COLOUR RANGE"/>
                            <Border Style="{StaticResource Card}">
                                <!-- v0.6.46: wrap children in a StackPanel so the
                                     Border (single-child container) holds the
                                     mode-picker row plus the gradient-endpoint
                                     row underneath it without the XAML parser
                                     tripping on multiple Border children. -->
                                <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="How lights match the warmth schedule"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="Circadian: native colour temperature (subtle, recommended). Custom gradient: bulbs drift through any colours you pick along the warmth axis (dramatic). Warm white only: clamped 5000 to 2700 K range, gentlest."/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="CboHueColorRange"
                                              Margin="0,0,14,0" MinWidth="160" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Circadian (recommended)"/>
                                        <ComboBoxItem Content="Custom gradient"/>
                                        <ComboBoxItem Content="Warm white only"/>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <!-- v0.6.55: limited-bulb fade onset.
                                     Controls how early CT-limited bulbs
                                     (IKEA Tradfri etc.) start dimming
                                     as the schedule passes their warmth
                                     limit. Higher = smoother (eases in
                                     earlier), lower = sharper cliff at
                                     the bulb's actual limit. -->
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Limited-bulb fade onset"/>
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="How much earlier than each bulb's CT limit it starts dimming. CT-limited bulbs (IKEA Tradfri, etc.) ramp brightness from full to off between this point and the schedule's deepest warmth, so they don't visually clash with full-range Hue bulbs at bedtime. Higher = smoother dim, lower = sharper cliff."/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" x:Name="SldHueBulbFadeOnset"
                                            Style="{StaticResource AppleSlider}"
                                            VerticalAlignment="Center"
                                            Minimum="0" Maximum="1500"
                                            SmallChange="50" LargeChange="100"
                                            IsSnapToTickEnabled="True" TickFrequency="50"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblHueBulbFadeOnset"/>
                                </Grid>
                                <!-- v0.6.49: multi-stop gradient editor, only visible
                                     when "Custom gradient" is selected. Photoshop-
                                     style: drag the marker triangles below the bar
                                     to reposition stops, double-click the bar to
                                     add a new stop, click a marker to select it,
                                     then "Edit" / "Remove" act on the selected stop. -->
                                <Border x:Name="HueGradientPanel"
                                        Style="{StaticResource RowDivider}"
                                        Visibility="Collapsed"/>
                                <StackPanel x:Name="HueGradientRow"
                                            Margin="14,8,14,12"
                                            Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Custom gradient"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Margin="0,0,0,10"
                                               Text="Drag the markers under the bar to position colour stops along the warmth axis. Click a marker to select it, then Edit to change its colour or Remove to delete it. Double-click on the bar to add a new stop."/>

                                    <!-- Kelvin axis labels above the bar. -->
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   Text="Warm (1500 K)"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   Text="Mid"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   Text="Cool (6500 K)"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- The gradient strip itself. Filled at runtime
                                         from the user's stops. Has a 1 px border so
                                         pure white stops are still visible against
                                         the light theme background. -->
                                    <Border CornerRadius="6"
                                            BorderBrush="{DynamicResource App.CardBorder}"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Rectangle x:Name="HueGradientBar"
                                                   Height="34"/>
                                    </Border>

                                    <!-- Marker track. Triangles are drawn into this
                                         canvas at runtime; clicks/drags are handled
                                         by the canvas itself so we don't have to
                                         wire dozens of per-shape mouse events. -->
                                    <Canvas x:Name="HueGradientMarkers"
                                            Height="22"
                                            Margin="0,2,0,0"
                                            Background="Transparent"/>

                                    <!-- Action row: shows the selected stop's kelvin
                                         + colour swatch and the Edit/Remove pills. -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="HueGradientSelectedSwatch"
                                                Grid.Column="0"
                                                Width="22" Height="22" CornerRadius="4"
                                                BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0"/>
                                        <TextBlock x:Name="LblHueGradientSelected"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   Text="No stop selected"/>
                                        <Button Grid.Column="3"
                                                x:Name="BtnHueGradientEditStop"
                                                Style="{StaticResource PillButton}"
                                                Margin="0,0,8,0"
                                                Content="Edit colour"
                                                ToolTip="Open the colour picker to change the colour of the selected gradient stop."/>
                                        <Button Grid.Column="4"
                                                x:Name="BtnHueGradientRemoveStop"
                                                Style="{StaticResource PillButton}"
                                                Content="Remove"
                                                ToolTip="Delete the selected gradient stop. The gradient must keep at least two stops."/>
                                    </Grid>
                                </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource CardCaption}" Text="ADJUSTMENT"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Brightness"/>
                                            <TextBlock Style="{StaticResource RowHint}"
                                                       Text="How bright the selected groups should be. Independent of screen brightness."/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" x:Name="SldHueBrightness" Style="{StaticResource AppleSlider}"
                                                Minimum="0" Maximum="100" TickFrequency="5"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblHueBrightness"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Warmth offset (K)"/>
                                            <TextBlock Style="{StaticResource RowHint}"
                                                       Text="Added to the screen's warmth. Negative = warmer than the screen, positive = cooler."/>
                                        </StackPanel>
                                        <Slider Grid.Column="1" x:Name="SldHueWarmthOffset" Style="{StaticResource AppleSlider}"
                                                Minimum="-3000" Maximum="3000" TickFrequency="100"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblHueWarmthOffset"/>
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}"/>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Ignore screen warmth boost"/>
                                            <TextBlock Style="{StaticResource RowHint}"
                                                       Text="When you boost the screen to neutral white temporarily (focus mode), don't blast Hue lights to white too. Recommended on."/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" x:Name="ChkHueIgnoreBoost" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- MONITORS -->
                    <StackPanel x:Name="PageMonitors" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Monitors"/>
                        <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,16"
                                   Text="Per-monitor offsets are added to the global brightness and warmth. Useful for a main monitor that's physically much brighter than a secondary one."/>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <ListView x:Name="LstMonitors" Background="Transparent" BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="14,10"/>
                                        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd"
                                                            CornerRadius="6"
                                                            Margin="6,2"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <GridViewRowPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.HoverBg}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectedBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridView.ColumnHeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="Padding" Value="14,8"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GridViewColumnHeader">
                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GridView.ColumnHeaderContainerStyle>
                                        <GridViewColumn Header="Display" Width="220" DisplayMemberBinding="{Binding DeviceName}"/>
                                        <GridViewColumn Header="Brightness" Width="120" DisplayMemberBinding="{Binding BrightnessOffset, StringFormat={}{0:+0;-0;0}}"/>
                                        <GridViewColumn Header="Warmth (K)" Width="120" DisplayMemberBinding="{Binding WarmthOffset, StringFormat={}{0:+0;-0;0} K}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                        <TextBlock Style="{StaticResource CardCaption}" Text="ADJUST SELECTED MONITOR"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Brightness offset"/>
                                    <Slider Grid.Column="1" x:Name="SldMonBrOffset"
                                            Minimum="-50" Maximum="50"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblMonBr"
                                               Cursor="SizeWE"
                                               ToolTip="Drag horizontally to adjust. Double-click to type a value."/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Warmth offset (K)"/>
                                    <Slider Grid.Column="1" x:Name="SldMonWrOffset"
                                            Minimum="-2000" Maximum="0"
                                            TickFrequency="50"
                                            IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueChip}" x:Name="LblMonWr"
                                               Cursor="SizeWE"
                                               ToolTip="Drag horizontally to adjust. Double-click to type a value."/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Reset all per-monitor offsets to zero"/>
                                    <Button Grid.Column="1" x:Name="BtnResetMonitors"
                                            Margin="0,0,16,0"
                                            Style="{StaticResource PillButton}"
                                            Content="Reset all"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- EXCLUSIONS -->
                    <StackPanel x:Name="PageExclusions" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Exclusions"/>
                        <TextBlock Margin="0,0,0,16"
                                   Foreground="{DynamicResource App.TextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Underlit pauses its dimming whenever any app on this list is in the foreground. Toggle a running app from the list, or add a custom name below."/>

                        <!-- Currently-running apps with toggle switches. The list
                             refreshes when the page is shown; the user can also
                             pull the latest with the Refresh button at the bottom. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="RUNNING APPS"/>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <StackPanel>
                                <ItemsControl x:Name="LstRunningApps" Margin="6,8,6,4"
                                              MaxHeight="320">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          PreviewMouseWheel="OnSmoothScroll">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource App.TextPrimary}"
                                                               FontSize="13"/>
                                                    <TextBlock Text="{Binding ProcessName}"
                                                               Foreground="{DynamicResource App.TextSecondary}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Margin="0,0,4,0"
                                                          IsChecked="{Binding IsExcluded, Mode=TwoWay}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}"
                                               Text="Re-scan running apps"/>
                                    <Button Grid.Column="1" x:Name="BtnRefreshRunningApps"
                                            Margin="0,0,16,0"
                                            Style="{StaticResource PillButton}"
                                            Content="Refresh"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Custom names: power-user textbox for apps the user
                             wants to exclude even when they aren't currently
                             running, or that don't appear in the list (services,
                             hidden processes, etc.). One name per line, no
                             extension. We auto-resolve them at runtime by
                             matching against the foreground process's name. -->
                        <TextBlock Style="{StaticResource CardCaption}" Text="CUSTOM"/>
                        <Border Style="{StaticResource Card}" Padding="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <!-- Edit field for custom names. -->
                                        <TextBox x:Name="TxtExclusions"
                                                 Style="{StaticResource AppleTextBox}"
                                                 MinHeight="120"
                                                 HorizontalAlignment="Stretch"
                                                 Margin="0"
                                                 TextAlignment="Left"
                                                 HorizontalContentAlignment="Stretch"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap"/>
                                        <!-- v0.6.49: placeholder shown only when
                                             the textbox is empty. WPF has no
                                             native placeholder; we layer a hit-
                                             test-invisible TextBlock and bind
                                             its Visibility to a DataTrigger on
                                             TxtExclusions.Text == "". -->
                                        <TextBlock x:Name="LblExclusionsPlaceholder"
                                                   IsHitTestVisible="False"
                                                   Margin="14,11,14,0"
                                                   VerticalAlignment="Top"
                                                   HorizontalAlignment="Left"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI Variable, Segoe UI"
                                                   Foreground="{DynamicResource App.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="Type a process name (no .exe), one per line. Click + to browse for an executable on your computer.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtExclusions}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" x:Name="BtnExclusionsBrowse"
                                            Margin="8,0,4,0"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="Browse for an executable on this computer">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource App.TextPrimary}"
                                                   Text="&#xE710;"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
